{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-icat",
        "source": "/home/cameron/Pictures/galaxy.gif",
        "width": 30,
        "height": 20,
    },

    "display": {
        "separator": "",
        "color": {
            "title": "white",
        }
    },


    "modules": [
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "title",
            "format": "{user-name} {home-dir}                      │",
            "key": "├󰊕 ",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘",
            "outputColor": "white"
        },

        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "cpu",
            "key": "├󰻠 ",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{name}                 │"
        },

        {
            "type": "gpu",
            "key": "├󰢮 ",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{name}                                │"
        },

        {
            "type": "memory",
            "key": "├󰍛 ",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{used} / {total}                         │"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘",
            "outputColor": "white"
        },

        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "os",
            "format": "{pretty-name}                                  │",
            "key": "├󰍹 ",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "type": "shell",
            "format": "{process-name} - {pretty-name}                                 │",
            "key": "├󰘧 ",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "type": "terminal",
            "format": "{pretty-name}                                       │",
            "key": "├󰆍 ",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘",
            "outputColor": "white"
        },
        
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "disk",
            "format": "{size-used} / {size-total}                       │",
            "key": "├󰉋 ",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘",
            "outputColor": "white"
        },
    ]
}
