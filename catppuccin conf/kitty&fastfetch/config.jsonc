

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "/home/cameron/Pictures/marsh3.png",
        "width": 30,
        "height": 20,
    },

    "display": {
        "separator": "",
        "color": {
            "title": "cyan",
        }
    },


    "modules": [
        {
            "type": "custom",
            "format": "┌───────────────────────USER───────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "title",
            "format": "{user-name} {home-dir}",
            "key": "├󰊕 ",
            "keyColor": "red",
            "outputColor": "red"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────┘",
            "outputColor": "white"
        },

        {
            "type": "custom",
            "format": "┌─────────────────────HARDWARE─────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "cpu",
            "key": "┌󰻠 ",
            "keyColor": "green",
            "outputColor": "green"
        },

        {
            "type": "gpu",
            "key": "├󰢮 ",
            "keyColor": "green",
            "outputColor": "green"
        },

        {
            "type": "memory",
            "key": "└󰍛 ",
            "keyColor": "green",
            "outputColor": "green"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────┘",
            "outputColor": "white"
        },

        {
            "type": "custom",
            "format": "┌─────────────────────SOFTWARE─────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "os",
            "format": "{pretty-name}",
            "key": "┌󰍹 ",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },

        {
            "type": "shell",
            "format": "{process-name} - {pretty-name}",
            "key": "├󰘧 ",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },

        {
            "type": "terminal",
            "format": "{pretty-name}",
            "key": "└󰆍 ",
            "keyColor": "cyan",
            "outputColor": "cyan"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────┘",
            "outputColor": "white"
        },
        
        {
            "type": "custom",
            "format": "┌───────────────────────DISK───────────────────────┐",
            "outputColor": "white"
        },

        {
            "type": "disk",
            "format": "{size-used} / {size-total}",
            "key": "├󰉋 ",
            "keyColor": "blue",
            "outputColor": "blue"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────┘",
            "outputColor": "white"
        },
        
        {
            "type": "custom",
            "format": "┌────────────────────────IP────────────────────────┐",
            "outputColor": "white"
        },
        
        {
            "type": "localip",
            "format": "{ifname} {ipv4}",
            "key": "├󰩟 ",
            "keyColor": "magenta",
            "outputColor": "magenta"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────┘",
            "outputColor": "white"
        }
    ]
}

